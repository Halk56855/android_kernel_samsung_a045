# ==============================================================================
# ArcKern+ v1.0 — touchdirt-oc.config
# Target Device : Samsung Galaxy A04 (SM-A045F)
# Platform      : MediaTek MT6765 (ARM64)
# Profile       : Balanced Overclock (CPU 2500/2000 MHz | GPU 900 MHz)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Balanced Overclock & Frequency Scaling
#    Big CPU: 2500000 kHz | LITTLE CPU: 2000000 kHz | GPU: 900000000 Hz
#    Keep CONFIG_ARCKERN_LOCK_MAX_FREQ=n to allow thermal & load scaling
# ------------------------------------------------------------------------------
CONFIG_ARCKERN_OC=y
CONFIG_ARCKERN_OC_2500_2000_900=y
CONFIG_ARCKERN_CPU_MAX_FREQ_BIG=2500000
CONFIG_ARCKERN_CPU_MAX_FREQ_LITTLE=2000000
CONFIG_ARCKERN_GPU_MAX_FREQ=900000000
CONFIG_ARCKERN_LOCK_MAX_FREQ=n
