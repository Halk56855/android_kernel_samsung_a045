#
# Rissu's Custom Configurations
# For Galaxy A05 and A04 (FinaSU + SUSFS + OC Ready)
#
CONFIG_LOCALVERSION="touchdirt-1.0v-plus-oc "
CONFIG_LOCALVERSION_AUTO=n
CONFIG_SAMSUNG_LMKD_DEBUG=n
CONFIG_USB_DEBUG_DETAILED_LOG=n
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_AVC_STATS=n
CONFIG_MTPROF=n
CONFIG_NL80211_TESTMODE=n
CONFIG_SND_DEBUG=n
CONFIG_SND_DEBUG_VERBOSE=n
CONFIG_SND_VERBOSE_PRINTK=n
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=n
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_SND_SOC_MT6357_ACCDET=y
CONFIG_SND_SOC_MT6359_ACCDET=n
CONFIG_MMSTAT_TRACER=n
CONFIG_IKHEADERS=n

# CPUFreq / GPU / Overclocking Support
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y

# KSU, FinaSU & SUSFS Requirements
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=n
# CONFIG_KSU_CMDLINE is not set
CONFIG_KPROBES=y
CONFIG_KALLSYMS_ALL=y
CONFIG_EXT4_FS=y
CONFIG_HEADERS_INSTALL=y
CONFIG_THREAD_INFO_IN_TASK=y
CONFIG_KSU_SUSFS=y
# Enable only if your SUSFS patch contains every ksu_handle_* call on ARM64 Built-In
# CONFIG_KSU_HOOK_SUSFS_INLINE is not set

CONFIG_ZRAM_DEFAULT_COMP_ALGORITHM="lz4"
CONFIG_DISABLE_TRACE_PRINTK=y
CONFIG_ARM64_SVE=n
CONFIG_REFCOUNT_FULL=n

# SELinux Permissive
CONFIG_TOUCHDIRT_FORCE_PERMISSIVE=y

# NoMount
CONFIG_NOMOUNT=y
