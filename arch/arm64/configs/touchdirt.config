# ==============================================================================
# ArcKern+ v1.0 — touchdirt.config
# Target Device : Samsung Galaxy A04 (SM-A045F)
# Platform      : MediaTek MT6765 (ARM64)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Build & Optimization (Clang + ThinLTO)
# ------------------------------------------------------------------------------
CONFIG_CC_IS_CLANG=y
CONFIG_LD_IS_LLD=y
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y
CONFIG_CFI_CLANG=n
CONFIG_SHADOW_CALL_STACK=n

# ------------------------------------------------------------------------------
# 2. Balanced Overclock & Frequency Scaling
#    CPU: 2500 / 2000 MHz | GPU: 900 MHz
#    Note: lock_max_freq stays disabled by default to prevent thermal spikes
# ------------------------------------------------------------------------------
CONFIG_ARCKERN_OC=y
CONFIG_ARCKERN_OC_2500_2000_900=y
CONFIG_ARCKERN_CPU_MAX_FREQ_BIG=2500000
CONFIG_ARCKERN_CPU_MAX_FREQ_LITTLE=2000000
CONFIG_ARCKERN_GPU_MAX_FREQ=900000000
CONFIG_ARCKERN_LOCK_MAX_FREQ=n

# ------------------------------------------------------------------------------
# 3. Root, Stealth & Mount Stack (BakaSU / SUSFS / NoMount / Vanilla)
#    Overridden per-variant in workflow files:
#      - bakasu-enforcing.yml
#      - bakasu-permissive.yml
#      - vanilla-enforcing.yml
#      - vanilla-permissive.yml
# ------------------------------------------------------------------------------
CONFIG_BAKASU=y
CONFIG_KSU_SUSFS=y
CONFIG_NOMOUNT=y
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y

# ------------------------------------------------------------------------------
# 4. SELinux Mode Defaults
#    Enforcing by default; Permissive enabled in *-permissive workflows
# ------------------------------------------------------------------------------
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=n

# ------------------------------------------------------------------------------
# 5. Filesystem & Kernel Identity Tweaks
# ------------------------------------------------------------------------------
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_DISCARD_THREAD_FIX=y
CONFIG_FAKE_UNAME=y
CONFIG_LOCALVERSION="-ArcKern+-v1.0"
CONFIG_LOCALVERSION_AUTO=n
